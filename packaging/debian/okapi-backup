#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "okapi-backup must be run as root." >&2
    exit 1
fi

export PYTHONPATH=/opt/okapi
export OKAPI_CONFIG_DIR=/etc/okapi
export OKAPI_STATE_DIR=/var/lib/okapi
export OKAPI_ENV_FILE=/etc/okapi/okapi.env
export OKAPI_SECRETS_ENV=/etc/okapi/secrets.env

cd /opt/okapi
exec /opt/okapi/venv/bin/flask --app run backup-sqlite "$@"
