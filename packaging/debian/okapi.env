# Parametres non sensibles d'OKAPI pour Ubuntu 24.04.
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_BIND_PORT=5000
WEBHOOK_ALLOWED_SOURCE_IPS=127.0.0.1,::1
WEBHOOK_MAX_CONTENT_LENGTH=65536
DATABASE_URL=sqlite:////var/lib/okapi/remediation.db
REQUIRE_REMEDIATION_TAG=true
REMEDIATION_TAG_NAME=remediation
REMEDIATION_TAG_VALUE=enabled

AUTOMATION_SCHEDULE_PATH=/etc/okapi/automation_schedule.json
WHITELIST_PATH=/etc/okapi/whitelist.json
REMEDIATION_CONFIG_PATH=/etc/okapi/remediation.json
PLAYBOOKS_DIR=/etc/okapi/playbooks

QUARANTINE_VLAN_EXISTS=false
QUARANTINE_VLAN_ISOLATED=false

SNMP_HOST=192.0.2.10
SNMP_PORT=161
SNMP_AUTH_PROTOCOL=SHA256
SNMP_PRIV_PROTOCOL=AES256
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1
SNMP_MIB_PACKAGE=pysnmp_mibs
SNMP_MIB_PATH=
SNMP_CAPABILITIES_PATH=/etc/okapi/snmp_capabilities.json

SNMP_WRITE_ENABLED=false
DRY_RUN=false
RUNTIME_SETTINGS_PATH=/var/lib/okapi/runtime-settings.json
REMEDIATION_MAX_ATTEMPTS=2
REMEDIATION_COOLDOWN_SECONDS=60
PORT_LOCK_DIR=/var/lib/okapi/port-locks
SQLITE_BACKUP_DIR=/var/backups/okapi
