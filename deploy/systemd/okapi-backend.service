[Unit]
Description=OKAPI local Zabbix webhook backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exauceeadm
Group=exauceeadm
WorkingDirectory=/home/exauceeadm/tfc-remediation-reseau-snmpv3
EnvironmentFile=/home/exauceeadm/tfc-remediation-reseau-snmpv3/.env
ExecStart=/home/exauceeadm/tfc-remediation-reseau-snmpv3/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5000 run:app
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
