# Flask / API
FLASK_DEBUG=false
WEBHOOK_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///data/remediation.db
REQUIRE_REMEDIATION_TAG=true
REMEDIATION_TAG_NAME=remediation
REMEDIATION_TAG_VALUE=enabled

# Politiques externes a la base de donnees
AUTOMATION_SCHEDULE_PATH=config/automation_schedule.json
WHITELIST_PATH=config/whitelist.json

# VLAN de quarantaine du laboratoire EVE-NG
QUARANTINE_VLAN_ID=18
QUARANTINE_VLAN_EXISTS=false
QUARANTINE_VLAN_ISOLATED=false

# SNMPv3 authPriv - valeurs factices uniquement
SNMP_HOST=192.0.2.10
SNMP_PORT=161
SNMP_USERNAME=CHANGE_ME
SNMP_AUTH_KEY=CHANGE_ME_AUTH_KEY
SNMP_PRIV_KEY=CHANGE_ME_PRIV_KEY
SNMP_AUTH_PROTOCOL=SHA256
SNMP_PRIV_PROTOCOL=AES256
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1
SNMP_MIB_PACKAGE=pysnmp_mibs
# Repertoire optionnel de modules MIB PySNMP locaux, sans acces Internet
SNMP_MIB_PATH=
SNMP_CAPABILITIES_PATH=config/snmp_capabilities.json

# Garde-fou global : mettre true uniquement dans le laboratoire valide
SNMP_WRITE_ENABLED=false
