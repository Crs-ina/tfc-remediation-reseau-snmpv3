# Flask / API
FLASK_DEBUG=false
WEBHOOK_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
# Zabbix and OKAPI run on the same laboratory host. Keep the backend private;
# only override the source list when a documented reverse proxy is required.
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_BIND_PORT=5000
WEBHOOK_ALLOWED_SOURCE_IPS=127.0.0.1,::1
WEBHOOK_MAX_CONTENT_LENGTH=65536
DATABASE_URL=sqlite:///data/remediation.db
REQUIRE_REMEDIATION_TAG=true
REMEDIATION_TAG_NAME=remediation
REMEDIATION_TAG_VALUE=enabled

# Politiques externes a la base de donnees
AUTOMATION_SCHEDULE_PATH=config/automation_schedule.json
WHITELIST_PATH=config/whitelist.json
REMEDIATION_CONFIG_PATH=config/remediation.json

# Le numero de VLAN est configure dans config/remediation.json.
QUARANTINE_VLAN_EXISTS=false
QUARANTINE_VLAN_ISOLATED=false

# SNMPv3 authPriv - valeurs factices uniquement
SNMP_HOST=192.0.2.10
SNMP_PORT=161
SNMP_USERNAME=CHANGE_ME
SNMP_AUTH_KEY=CHANGE_ME_AUTH_KEY
SNMP_PRIV_KEY=CHANGE_ME_PRIV_KEY
SNMP_AUTH_PROTOCOL=SHA256
SNMP_PRIV_PROTOCOL=AES256
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1
SNMP_MIB_PACKAGE=pysnmp_mibs
# Repertoire optionnel de modules MIB PySNMP locaux, sans acces Internet
SNMP_MIB_PATH=
SNMP_CAPABILITIES_PATH=config/snmp_capabilities.json

# Garde-fou global : mettre true uniquement dans le laboratoire valide.
# DRY_RUN=true reste prioritaire et bloque chaque SET, meme si les ecritures
# sont activees. Utiliser DRY_RUN=true pour valider le parcours sans mutation.
SNMP_WRITE_ENABLED=false
# Valeur initiale si aucun reglage persistant n'existe encore. La CLI `okapi`
# peut ensuite activer/desactiver le dry-run apres reauthentification Linux/PAM.
DRY_RUN=false
RUNTIME_SETTINGS_PATH=data/runtime-settings.json
REMEDIATION_MAX_ATTEMPTS=2
REMEDIATION_COOLDOWN_SECONDS=60
PORT_LOCK_DIR=data/port-locks
